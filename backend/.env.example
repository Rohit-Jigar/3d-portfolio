# Environment mode: development or production
ENVIRONMENT=development
APP_NAME=Jigar Rohit Portfolio API
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated for additional domains in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
ADDITIONAL_CORS_ORIGINS=https://jigar-rohit.onrender.com

# Rate limiting
RATE_LIMIT_CONTACT=5/minute

# Optional: When configured with production email service (e.g., SendGrid/Resend)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_api_key_here
